---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DecorativeVisual from '../components/DecorativeVisual.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import { branches, type BranchId } from '../data/programs';

const branchIds = Object.keys(branches) as BranchId[];
const areas = [
  { title: 'Развитие и учёба', text: 'Занятия, которые поддерживают интерес к познанию и помогают осваивать учебные навыки.', tone: 'bg-[#f6ced1]' },
  { title: 'Творчество', text: 'Рисование, работа с разными материалами и другие творческие форматы.', tone: 'bg-[#ffe0ad]' },
  { title: 'Логика и наука', text: 'Направления для знакомства с исследованиями, логическими задачами и шахматами.', tone: 'bg-[#f7e796]' },
  { title: 'Движение', text: 'Занятия, связанные с движением, координацией и физической активностью.', tone: 'bg-[#cce8d0]' },
  { title: 'Индивидуальные занятия', text: 'Форматы, в которых программа и темп работы подбираются индивидуально.', tone: 'bg-[#dceff4]' },
];
---
<Layout title="О детском центре ТАЛАНТиЯ в Челябинске" description="«ТАЛАНТиЯ» — детский центр в Челябинске с двумя филиалами и программами для детей и взрослых.">
  <Header />
  <main id="top">
    <section class="relative overflow-hidden border-b-2 border-[#d3bd92] pb-16 pt-8 md:pb-24 md:pt-10">
      <div class="container-site">
        <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'О центре' }]} />
        <div class="mt-8 grid items-center gap-12 lg:grid-cols-[1fr_.82fr]">
          <div>
            <p class="eyebrow">Страна талантливых друзей</p>
            <h1 class="headline mt-5">Место, где интересно учиться и создавать</h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-muted md:text-xl">«ТАЛАНТиЯ» — пространство, где дети учатся, экспериментируют, творят и находят друзей. Центр помогает подобрать занятия по возрасту и интересам ребёнка. У нас уютно, по-домашнему.</p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a class="button-primary" href="/programs/">Выбрать направление</a>
              <a class="button-secondary" href="tel:+79193335835">Позвонить</a>
            </div>
          </div>
          <DecorativeVisual label="Страна талантливых друзей" tone="orange" />
        </div>
      </div>
    </section>

    <section class="section-space bg-[#fffdf6]" aria-labelledby="about-story-title">
      <div class="container-site grid gap-8 lg:grid-cols-[.7fr_1fr] lg:gap-16">
        <div>
          <p class="eyebrow">О центре</p>
          <h2 id="about-story-title" class="headline mt-4">Более 20 лет рядом с семьями Челябинска</h2>
        </div>
        <div class="paper-card rounded-[2rem] bg-cream p-7 md:p-10">
          <p class="text-xl font-bold leading-9 md:text-2xl">Центр объединяет развивающие, образовательные, творческие и двигательные направления для детей, а также отдельные программы для взрослых.</p>
          <p class="mt-5 leading-7 text-muted">Задача сайта — помочь семье увидеть актуальные направления, выбрать удобный филиал и связаться с центром для получения точного расписания и условий занятий.</p>
          <p class="mt-5 leading-7 text-muted">«ТАЛАНТиЯ» объединяет детей и родителей, которым важно развиваться, пробовать новое и поддерживать друг друга.</p>
        </div>
      </div>
    </section>

    <section class="section-space" aria-labelledby="about-facts-title">
      <div class="container-site">
        <p class="eyebrow">Подтверждённые факты</p>
        <h2 id="about-facts-title" class="headline mt-4">Коротко о «ТАЛАНТиИ»</h2>
        <dl class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          <div class="paper-card rounded-[1.75rem] bg-cream p-7"><dt class="text-sm font-black uppercase tracking-[.1em] text-brand">Опыт</dt><dd class="mt-3 text-2xl font-black">Более 20 лет</dd></div>
          <div class="paper-card rounded-[1.75rem] bg-cream p-7"><dt class="text-sm font-black uppercase tracking-[.1em] text-brand">Город</dt><dd class="mt-3 text-2xl font-black">Челябинск</dd></div>
          <div class="paper-card rounded-[1.75rem] bg-cream p-7"><dt class="text-sm font-black uppercase tracking-[.1em] text-brand">Филиалы</dt><dd class="mt-3 text-2xl font-black">Два адреса</dd></div>
          <div class="paper-card rounded-[1.75rem] bg-cream p-7"><dt class="text-sm font-black uppercase tracking-[.1em] text-brand">Программы</dt><dd class="mt-3 text-2xl font-black">Для детей и взрослых</dd></div>
        </dl>
      </div>
    </section>

    <section class="section-space border-y-2 border-[#d3bd92] bg-[#fffdf6]" aria-labelledby="about-areas-title">
      <div class="container-site">
        <p class="eyebrow">Направления работы</p>
        <h2 id="about-areas-title" class="headline mt-4">Разные способы раскрывать интересы</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {areas.map((area) => <article class:list={['paper-card rounded-[1.75rem] p-7', area.tone]}><h3 class="text-2xl font-black">{area.title}</h3><p class="mt-4 leading-7 text-muted">{area.text}</p></article>)}
        </div>
      </div>
    </section>

    <section class="section-space" aria-labelledby="about-branches-title">
      <div class="container-site">
        <p class="eyebrow">Два филиала</p>
        <h2 id="about-branches-title" class="headline mt-4">Занятия в разных районах города</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {branchIds.map((branchId) => <article class="paper-card rounded-[2rem] bg-cream p-7 md:p-9"><h3 class="text-2xl font-black">{branches[branchId].shortName}</h3><address class="mt-4 not-italic text-lg leading-7 text-muted">г. {branches[branchId].city}, {branches[branchId].address}</address></article>)}
        </div>
        <a class="button-secondary mt-8" href="/contacts/">Контакты филиалов</a>
      </div>
    </section>

    <PhoneCTA title="Поможем найти подходящее направление" text="Посмотрите каталог или позвоните — поможем подобрать занятия по возрасту и интересам." secondaryHref="/programs/" secondaryLabel="Перейти в каталог" />
  </main>
  <Footer />
</Layout>

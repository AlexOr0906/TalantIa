---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import BranchMap from '../components/BranchMap.astro';
import { branches, programs, type BranchId } from '../data/programs';

const visiblePrograms = programs.filter((program) => program.status === 'active' || program.status === 'planned');
const branchIds = Object.keys(branches) as BranchId[];
const programsByBranch = Object.fromEntries(branchIds.map((branchId) => [branchId, visiblePrograms.filter((program) => program.branches.includes(branchId))]));
---
<Layout title="Контакты детского центра ТАЛАНТиЯ в Челябинске" description="Телефон и адреса двух филиалов детского центра «ТАЛАНТиЯ» в Челябинске.">
  <Header />
  <main id="top">
    <section class="relative overflow-hidden border-b-2 border-[#d3bd92] pb-16 pt-8 md:pb-24 md:pt-10">
      <div class="container-site">
        <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Контакты' }]} />
        <div class="mt-8 grid items-center gap-12 lg:grid-cols-[1fr_.8fr]">
          <div>
            <p class="eyebrow">Мы в Челябинске</p>
            <h1 class="headline mt-5">Контакты и филиалы</h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-muted md:text-xl">Позвоните нам — поможем выбрать направление и подскажем, в каком филиале проходят подходящие занятия.</p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a class="button-primary" href="tel:+79193335835">Позвонить</a>
              <button class="button-secondary" type="button" data-open-lead-form data-interest="Выбор филиала">Оставить заявку</button>
              <a class="button-secondary" href="https://vk.ru/74talantia" target="_blank" rel="noopener noreferrer">Официальная группа VK <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <figure class="relative overflow-hidden rounded-[2rem] border-2 border-[#7b6248] bg-[#dcefe0] p-3 shadow-[6px_7px_0_#e5ded2] sm:p-4">
            <div class="grid aspect-[8/5] grid-cols-2 gap-2 overflow-hidden rounded-[1.35rem] sm:gap-3">
              <div class="relative min-w-0 overflow-hidden rounded-l-[1.2rem]">
                <img
                  class="h-full w-full object-cover"
                  src="/images/branches/molodogvardeytsev.webp"
                  alt="Вход в филиал «ТАЛАНТиЯ» на улице Молодогвардейцев"
                  width="900"
                  height="1499"
                  loading="eager"
                  fetchpriority="high"
                />
                <span class="absolute inset-x-2 bottom-2 rounded-full bg-white/95 px-3 py-2 text-center text-xs font-black leading-tight text-ink shadow-sm sm:bottom-3 sm:text-sm">
                  Молодогвардейцев
                </span>
              </div>
              <div class="relative min-w-0 overflow-hidden rounded-r-[1.2rem]">
                <img
                  class="h-full w-full object-cover"
                  src="/images/branches/university-embankment.webp"
                  alt="Вход в филиал «ТАЛАНТиЯ» на Университетской Набережной"
                  width="900"
                  height="1125"
                  loading="eager"
                  fetchpriority="high"
                />
                <span class="absolute inset-x-2 bottom-2 rounded-full bg-white/95 px-2 py-2 text-center text-xs font-black leading-tight text-ink shadow-sm sm:bottom-3 sm:px-3 sm:text-sm">
                  Университетская Набережная
                </span>
              </div>
            </div>
            <figcaption class="sr-only">Фасады двух филиалов детского центра «ТАЛАНТиЯ» в Челябинске</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section-space bg-[#fffdf6]" aria-labelledby="branches-title">
      <div class="container-site">
        <p class="eyebrow">Адреса</p>
        <h2 id="branches-title" class="headline mt-4">Выберите удобный филиал</h2>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">Набор направлений в филиалах различается. Сначала выберите занятие или свяжитесь с центром — подскажем подходящий адрес.</p>
        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          {branchIds.map((branchId) => {
            const branchPrograms = programsByBranch[branchId];
            return <BranchMap branchId={branchId} programs={branchPrograms} />;
          })}
        </div>
      </div>
    </section>
    <PhoneCTA title="Хотите выбрать занятие?" text="Позвоните — расскажем о направлениях в каждом филиале и поможем с выбором." secondaryHref="/programs/" secondaryLabel="Смотреть направления" />
  </main>
  <Footer />
</Layout>

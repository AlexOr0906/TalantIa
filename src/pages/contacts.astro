---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DecorativeVisual from '../components/DecorativeVisual.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import { branches, programs, type BranchId } from '../data/programs';

const visiblePrograms = programs.filter((program) => program.status === 'active' || program.status === 'planned');
const branchIds = Object.keys(branches) as BranchId[];
const programsByBranch = Object.fromEntries(branchIds.map((branchId) => [branchId, visiblePrograms.filter((program) => program.branches.includes(branchId))]));
---
<Layout title="Контакты детского центра ТАЛАНТиЯ в Челябинске" description="Телефон и адреса двух филиалов детского центра «ТАЛАНТиЯ» в Челябинске.">
  <Header />
  <main id="top">
    <section class="relative overflow-hidden border-b-2 border-[#d3bd92] pb-16 pt-8 md:pb-24 md:pt-10">
      <div class="container-site">
        <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Контакты' }]} />
        <div class="mt-8 grid items-center gap-12 lg:grid-cols-[1fr_.8fr]">
          <div>
            <p class="eyebrow">Мы в Челябинске</p>
            <h1 class="headline mt-5">Контакты и филиалы</h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-muted md:text-xl">Позвоните нам — поможем выбрать направление и подскажем, в каком филиале проходят подходящие занятия.</p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a class="button-primary" href="tel:+79193335835">+7 (919) 333-58-35</a>
              <a class="button-secondary" href="https://vk.ru/74talantia" target="_blank" rel="noopener noreferrer">Официальная группа VK <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <DecorativeVisual label="Два филиала в Челябинске" tone="green" compact />
        </div>
      </div>
    </section>

    <section class="section-space bg-[#fffdf6]" aria-labelledby="branches-title">
      <div class="container-site">
        <p class="eyebrow">Адреса</p>
        <h2 id="branches-title" class="headline mt-4">Выберите удобный филиал</h2>
        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          {branchIds.map((branchId) => {
            const branch = branches[branchId];
            const branchPrograms = programsByBranch[branchId];
            return (
              <article class="paper-card flex flex-col rounded-[2rem] bg-cream p-6 md:p-9">
                <p class="text-xs font-black uppercase tracking-[.12em] text-brand">Филиал</p>
                <h3 class="mt-3 text-2xl font-black leading-tight md:text-3xl">{branch.shortName}</h3>
                <address class="mt-4 not-italic text-lg leading-7 text-muted">г. {branch.city}, {branch.address}</address>
                <h4 class="mt-8 text-lg font-black">Направления в филиале</h4>
                <ul class="mt-3 grid gap-1 sm:grid-cols-2">
                  {branchPrograms.map((program) => (
                    <li>
                      <a class="flex min-h-11 items-center gap-2 rounded-xl px-2 py-2 font-bold hover:bg-white hover:text-brand" href={`/programs/${program.slug}/`}>
                        <span aria-hidden="true">→</span><span>{program.title}{program.status === 'planned' && program.launchNote ? <small class="ml-2 rounded-full bg-[#fff3b5] px-2 py-1 text-xs">{program.launchNote}</small> : null}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })}
        </div>
      </div>
    </section>
    <PhoneCTA title="Хотите выбрать занятие?" text="Позвоните — расскажем о направлениях в каждом филиале и поможем с выбором." secondaryHref="/programs/" secondaryLabel="Смотреть направления" />
  </main>
  <Footer />
</Layout>

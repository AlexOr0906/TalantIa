---
import { branches, type Program } from '../data/programs';

interface Props {
  program: Program;
  index: number;
}

const { program, index } = Astro.props;
const accentClass = {
  red: 'bg-[#f6ced1] text-brand',
  orange: 'bg-[#ffe0ad] text-[#8f5210]',
  gold: 'bg-[#f7e796] text-[#6e5908]',
  coral: 'bg-[#cce8d0] text-[#476b25]',
};
const categorySymbols = {
  'Развитие и учёба': 'Aa',
  'Языки': 'A',
  'Логика и наука': '⚗',
  'Творчество': '✦',
  'Движение': '↗',
  'Индивидуальные занятия': '●',
  'Для взрослых': '○',
};
const ageLabel = program.audience === 'adults'
  ? 'Для взрослых'
  : program.ageGroups[0]
    ? `с ${program.ageGroups[0].minAge} лет`
    : null;
const branchLabel = program.branches.length === 2
  ? 'Оба филиала'
  : program.branches[0]
    ? branches[program.branches[0]].shortName
    : null;
const formatLabel = program.formats.includes('group') && program.formats.includes('individual')
  ? 'В группах и индивидуально'
  : program.formats.includes('individual')
    ? 'Индивидуально'
    : program.formats.includes('express')
      ? 'Экспресс-курс'
      : null;
const metaLabels = [ageLabel, branchLabel, program.launchNote ?? formatLabel].filter(Boolean).slice(0, 3);
---
<article
  class:list={[
    'paper-card flex min-h-[22rem] flex-col rounded-[1.75rem] bg-cream p-5 transition duration-200 hover:-translate-y-1 md:p-6',
    index % 2 ? 'rotate-[.25deg]' : 'rotate-[-.25deg]',
  ]}
  data-program-card
  data-category={program.category}
  data-branches={program.branches.join(',')}
>
  <div class="flex items-start justify-between gap-3">
    <span class:list={['rounded-full px-3 py-1.5 text-xs font-extrabold', accentClass[program.accent]]}>{program.category}</span>
    <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-white text-xl font-black text-brand shadow-sm" aria-hidden="true">{categorySymbols[program.category]}</span>
  </div>
  <h2 class="mt-7 text-2xl font-black leading-tight tracking-tight">{program.title}</h2>
  {metaLabels.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {metaLabels.map((label) => <span class="rounded-full border border-[#d7c39c] bg-white px-3 py-1.5 text-xs font-extrabold text-ink">{label}</span>)}
    </div>
  )}
  {program.shortDescription && <p class="mt-4 text-sm leading-6 text-muted">{program.shortDescription}</p>}
  {program.primaryBranch && <p class="mt-3 text-xs leading-5 text-muted">Основные занятия — на Университетской Набережной</p>}
  <a class="mt-auto flex min-h-11 items-center gap-2 pt-6 font-extrabold text-brand after:content-['→'] hover:text-brand-dark" href="#consultation" aria-label={`Узнать подробнее: ${program.title}`}>Узнать подробнее</a>
</article>

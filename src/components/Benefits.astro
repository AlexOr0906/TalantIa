---
const benefits = [
  ['✓', 'Работаем с 2005 года', 'Более 20 лет проводим развивающие, учебные и творческие занятия для детей.'],
  ['◌', 'Небольшие группы', 'Такой формат используется в тех направлениях, где он предусмотрен.'],
  ['✦', 'Разные направления', 'Можно сочетать учёбу, творчество, движение, логику и индивидуальные занятия.'],
  ['↗', 'Два филиала', 'Выбор адреса зависит от направления и подходящей группы.'],
];
---
<section class="section-space bg-[#4f6f2e] text-white" style="background-image: radial-gradient(rgb(255 255 255 / .12) 1px, transparent 1px); background-size: 18px 18px;">
  <div class="container-site">
    <p class="eyebrow !text-[#ffe28a]">Почему ТАЛАНТиЯ</p>
    <div class="mt-4 grid gap-10 lg:grid-cols-[.72fr_1.28fr]">
      <h2 class="headline max-w-xl">Поддерживаем интерес, самостоятельность и уверенность</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {benefits.map(([icon, title, text], index) => <article class:list={["paper-card min-h-56 rounded-[2rem] p-6 text-ink md:p-8", index % 2 ? 'bg-[#dceec9] rotate-[.6deg]' : 'bg-[#fff3c5] rotate-[-.6deg]']}><span class="grid size-12 place-items-center rounded-full bg-brand text-2xl font-black text-white">{icon}</span><h3 class="mt-7 text-xl font-black">{title}</h3><p class="mt-3 text-sm leading-6 text-muted">{text}</p></article>)}
      </div>
    </div>
  </div>
</section>

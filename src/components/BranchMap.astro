---
import { branches, type BranchId, type Program } from '../data/programs';

interface Props {
  branchId: BranchId;
  programs: Program[];
}

const { branchId, programs } = Astro.props;
const branch = branches[branchId];
---
<article class="paper-card overflow-hidden rounded-[2rem] bg-cream">
  <div class="p-6 md:p-9">
    <p class="text-xs font-black uppercase tracking-[.12em] text-brand">Филиал</p>
    <h3 class="mt-3 text-2xl font-black leading-tight md:text-3xl">{branch.shortName}</h3>
    <address class="mt-4 not-italic text-lg leading-7 text-muted">г. {branch.city}, {branch.address}</address>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="button-secondary" href={branch.mapSearchUrl} target="_blank" rel="noopener noreferrer">
        Открыть в Яндекс Картах <span aria-hidden="true">↗</span>
      </a>
      <a class="button-secondary" href="tel:+79193335835">Позвонить</a>
      <button class="button-primary" type="button" data-open-lead-form data-interest={`Филиал: ${branch.shortName}`}>Оставить заявку</button>
    </div>
  </div>

  <div class="border-y-2 border-[#d3bd92] bg-[#eee5d2]">
    <iframe
      class="block aspect-[4/3] w-full border-0 sm:aspect-[16/9]"
      src={branch.mapEmbedUrl}
      title={`Карта филиала «${branch.shortName}»: ${branch.address}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
    <noscript>
      <p class="p-5 text-center">
        <a class="font-extrabold text-brand underline" href={branch.mapSearchUrl}>Посмотреть адрес в Яндекс Картах</a>
      </p>
    </noscript>
  </div>

  <div class="p-6 md:p-9">
    <h4 class="text-lg font-black">Направления в филиале</h4>
    <ul class="mt-3 grid gap-1 sm:grid-cols-2">
      {programs.map((program) => (
        <li>
          <a class="flex min-h-11 items-center gap-2 rounded-xl px-2 py-2 font-bold hover:bg-white hover:text-brand" href={`/programs/${program.slug}/`}>
            <span aria-hidden="true">→</span>
            <span>{program.title}{program.status === 'planned' && program.launchNote ? <small class="ml-2 rounded-full bg-[#fff3b5] px-2 py-1 text-xs">{program.launchNote}</small> : null}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</article>

---
interface Props { title: string; text: string; secondaryHref?: string; secondaryLabel?: string; }
const { title, text, secondaryHref, secondaryLabel } = Astro.props;
---
<section class="section-space" aria-labelledby="phone-cta-title">
  <div class="container-site">
    <div class="paper-card relative overflow-hidden rounded-[2rem] bg-brand p-7 text-white md:p-12 lg:p-16">
      <div class="absolute -right-12 -top-12 size-48 rounded-full border-[20px] border-warm/45" aria-hidden="true"></div>
      <div class="relative max-w-4xl">
        <h2 id="phone-cta-title" class="text-[clamp(2rem,4vw,3.4rem)] font-black leading-[1.08] tracking-[-.01em] text-balance">{title}</h2>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-white/85">{text}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a class="paper-card inline-flex min-h-11 items-center justify-center rounded-full bg-[#fff3b5] px-6 py-3 text-center font-black text-ink transition hover:bg-white" href="tel:+79193335835">Позвонить +7 (919) 333-58-35</a>
          {secondaryHref && secondaryLabel && <a class="inline-flex min-h-11 items-center justify-center rounded-full border-2 border-white px-6 py-3 text-center font-black text-white hover:bg-white hover:text-brand" href={secondaryHref}>{secondaryLabel}</a>}
        </div>
      </div>
    </div>
  </div>
</section>

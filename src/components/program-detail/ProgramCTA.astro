---
interface Props { title?: string; text?: string; }
const { title = 'Хотите узнать расписание и стоимость?', text = 'Позвоните — расскажем о группах и поможем записаться.' } = Astro.props;
---
<section class="section-space border-t-2 border-[#d3bd92]" aria-labelledby="program-cta-title">
  <div class="container-site">
    <div class="paper-card relative overflow-hidden rounded-[2rem] bg-brand p-7 text-white md:p-12 lg:p-16">
      <div class="absolute -right-12 -top-12 size-48 rounded-full border-[20px] border-warm/45" aria-hidden="true"></div>
      <div class="relative max-w-4xl">
        <h2 id="program-cta-title" class="text-3xl font-black leading-[1.08] tracking-[-.01em] md:text-5xl">{title}</h2>
        <p class="mt-5 text-lg leading-8 text-white/90">{text}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <button class="paper-card inline-flex min-h-11 items-center justify-center rounded-full bg-[#fff3b5] px-6 py-3 text-center font-black text-ink transition hover:bg-white" type="button" data-open-lead-form>Оставить заявку</button>
          <a class="inline-flex min-h-11 items-center justify-center rounded-full border-2 border-white px-6 py-3 text-center font-black text-white transition hover:bg-white hover:text-brand" href="tel:+79193335835">Позвонить</a>
        </div>
      </div>
    </div>
  </div>
</section>

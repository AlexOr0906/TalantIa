---
import { branches, type BranchId } from '../../data/programs';
interface Props { branchIds?: BranchId[]; primaryBranch?: BranchId; }
const { branchIds = [], primaryBranch } = Astro.props;
---
{branchIds.length > 0 && (
  <section class="section-space" aria-labelledby="program-locations-title">
    <div class="container-site">
      <p class="eyebrow">Где проходят занятия</p>
      <h2 id="program-locations-title" class="mt-4 text-[clamp(2.25rem,4.5vw,4rem)] font-black leading-[1.08] tracking-[-.01em] text-balance">Два филиала в Челябинске</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {branchIds.map((branchId) => (
          <article class:list={['paper-card rounded-[2rem] p-7 md:p-9', branchId === primaryBranch ? 'bg-[#fff3b5]' : 'bg-cream']}>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-2xl font-black">{branches[branchId].shortName}</h3>
              {branchId === primaryBranch && <span class="rounded-full bg-brand px-3 py-1.5 text-xs font-black uppercase tracking-wide text-white">Основная площадка</span>}
            </div>
            <address class="mt-5 not-italic text-lg leading-7 text-muted">{branches[branchId].address}</address>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

---
interface Item { label: string; href?: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
<nav aria-label="Хлебные крошки">
  <ol class="flex min-h-11 flex-wrap items-center gap-2 text-sm font-bold text-muted">
    {items.map((item, index) => (
      <li class="contents">
        {item.href
          ? <a class="flex min-h-11 items-center rounded-lg hover:text-brand" href={item.href}>{item.label}</a>
          : <span aria-current="page" class="flex min-h-11 items-center text-ink">{item.label}</span>}
        {index < items.length - 1 && <span aria-hidden="true">→</span>}
      </li>
    ))}
  </ol>
</nav>

---
import type { SuccessStory } from '../data/successStories';

interface Props {
  story: SuccessStory;
}

const { story } = Astro.props;
---
{story.localVideo && (
  <figure>
    <video
      class="aspect-video w-full rounded-[1.5rem] bg-[#2f241d]"
      controls
      preload="metadata"
      poster={story.localVideo.poster}
      aria-label={story.alt ?? `Видео: ${story.shortTitle}`}
    >
      <source src={story.localVideo.src} />
      Ваш браузер не поддерживает видео. Можно открыть материал по прямой ссылке.
    </video>
    {story.localVideo.caption && <figcaption class="mt-3 text-sm leading-6 text-muted">{story.localVideo.caption}</figcaption>}
  </figure>
)}

{!story.localVideo && story.externalVideoUrl && (
  <div class="rounded-[1.5rem] border-2 border-[#d3bd92] bg-white p-5">
    <p class="font-bold">Видео откроется только после вашего действия.</p>
    <a class="button-secondary mt-4" href={story.externalVideoUrl} target="_blank" rel="noopener noreferrer">
      Открыть видео <span aria-hidden="true">↗</span>
    </a>
  </div>
)}

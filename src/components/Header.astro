---
const nav = [
  ['Направления', '/programs/'], ['Праздники', '/events/'],
  ['О центре', '/about/'], ['Контакты', '/contacts/'],
];
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<header class="sticky top-0 z-50 border-b-2 border-[#ccb993] bg-cream/96 backdrop-blur">
  <div class="container-site flex min-h-24 items-center justify-between gap-4">
    <a href="/" class="flex min-h-11 items-center gap-3" aria-label="ТАЛАНТиЯ — на главную">
      <img src="/images/talantiya-logo-transparent.png" alt="ТАЛАНТиЯ — страна талантливых друзей" class="h-[76px] w-auto object-contain" width="254" height="161" />
      <span class="hidden border-l-2 border-[#d9c39b] pl-3 text-[11px] font-bold leading-4 text-muted lg:block">Детский центр<br />в Челябинске</span>
    </a>
    <nav class="hidden xl:block" aria-label="Основная навигация">
      <ul class="flex items-center gap-1">
        {nav.map(([label, href]) => <li><a class:list={['flex min-h-11 items-center rounded-full px-3 text-sm font-extrabold hover:bg-white hover:text-brand', isCurrent(href) && 'bg-white text-brand']} href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a></li>)}
      </ul>
    </nav>
    <div class="hidden items-center gap-3 md:flex">
      <a class="flex min-h-11 items-center font-bold whitespace-nowrap hover:text-brand" href="tel:+79193335835">+7 (919) 333-58-35</a>
      <button class="button-primary" type="button" data-open-lead-form>Оставить заявку</button>
    </div>
    <details class="relative md:hidden" data-mobile-menu>
      <summary class="relative z-30 grid size-11 cursor-pointer list-none place-items-center rounded-full border-2 border-[#7b6248] bg-white" aria-label="Открыть меню" aria-controls="mobile-navigation">
        <span class="text-xl leading-none">☰</span>
      </summary>
      <span class="fixed inset-0 z-10 bg-[#2f241d]/45" aria-hidden="true"></span>
      <div id="mobile-navigation" class="absolute right-0 top-14 z-30 w-[min(88vw,22rem)] rounded-3xl border border-black/10 bg-white p-4 shadow-2xl">
        <nav aria-label="Мобильная навигация">
          <ul>{nav.map(([label, href]) => <li><a class:list={['flex min-h-11 items-center rounded-xl px-3 font-bold hover:bg-sand', isCurrent(href) && 'bg-sand text-brand']} href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a></li>)}</ul>
        </nav>
        <a class="mt-3 flex min-h-11 items-center px-3 font-bold text-brand" href="tel:+79193335835">+7 (919) 333-58-35</a>
        <button class="button-primary mt-2 w-full" type="button" data-open-lead-form>Оставить заявку</button>
      </div>
    </details>
  </div>
</header>

<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  const menuSummary = mobileMenu?.querySelector<HTMLElement>('summary');

  mobileMenu?.addEventListener('toggle', () => {
    menuSummary?.setAttribute('aria-label', mobileMenu.open ? 'Закрыть меню' : 'Открыть меню');
  });

  menuSummary?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      if (mobileMenu) mobileMenu.open = !mobileMenu.open;
    }
  });

  mobileMenu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a, [data-open-lead-form]')) mobileMenu.open = false;
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenu?.open) {
      mobileMenu.open = false;
      menuSummary?.focus();
    }
  });
</script>

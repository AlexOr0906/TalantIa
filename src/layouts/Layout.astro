---
import '../styles/global.css';
import LeadFormModal from '../components/LeadFormModal.astro';
interface Props { title: string; description: string; image?: string; noindex?: boolean; }
const { title, description, image, noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const ogImage = image && Astro.site ? new URL(image, Astro.site) : null;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ТАЛАНТиЯ',
  ...(Astro.site ? { url: Astro.site.href } : {}),
  telephone: '+79193335835',
  sameAs: ['https://vk.ru/74talantia'],
  address: [
    { '@type': 'PostalAddress', addressLocality: 'Челябинск', streetAddress: 'ул. Молодогвардейцев, 39В', addressCountry: 'RU' },
    { '@type': 'PostalAddress', addressLocality: 'Челябинск', streetAddress: 'ул. Университетская Набережная, 48', addressCountry: 'RU' },
  ],
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fffaf4" />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/images/talantiya-logo.png" type="image/png" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#top">Перейти к содержанию</a>
    <slot />
    <LeadFormModal />
  </body>
</html>
